{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Message Envelope",
  "type": "object",
  "required": ["message_id","timestamp","sender_agent_id","message_type","payload","provenance"],
  "properties": {
    "message_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sender_agent_id": { "type": "string" },
    "recipient_agent_id": { "type": ["string","null"] },
    "message_type": { "type": "string", "enum": ["COMMAND","DATA","EVENT","RESPONSE"] },
    "payload": { "type": "object" },
    "signature": { "type": ["string","null"] },
    "nonce": { "type": ["string","null"] },
    "correlation_id": { "type": ["string","null"] },
    "provenance": {
      "type": "object",
      "required": ["origin","collection_hash","consent_pointer"],
      "properties": {
        "origin": { "type": "string" },
        "collection_hash": { "type": "string" },
        "consent_pointer": { "type": "string" }
      }
    }
  }
}
